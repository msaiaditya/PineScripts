//@version=5
strategy("Ichimoku Cloud with Trailing SL", shorttitle="Ichi TSL", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Description: Long/Short crypto strategy using Ichimoku Cloud for entries with arithmetic progression trailing stop loss
// Long Entry: TK Cross Up + Price Above Cloud Support + Bullish Cloud
// Short Entry: TK Cross Down + Price Below Cloud Resistance + Bearish Cloud
// Exit: Opposite TK Cross or Trailing stop loss (1% increment steps)

// ==================== INPUTS ====================
// Ichimoku Settings
conversionPeriods = input.int(20, minval=1, title="Conversion Line Length", group="Ichimoku")
basePeriods = input.int(60, minval=1, title="Base Line Length", group="Ichimoku")
laggingSpan2Periods = input.int(120, minval=1, title="Leading Span B Length", group="Ichimoku")
displacement = input.int(30, minval=1, title="Displacement", group="Ichimoku")

// Trailing Stop Loss Settings
useTSL = input.bool(true, title="Enable Trailing Stop Loss", group="Trailing Stop Loss")
tslIncrement = input.float(1.0, minval=0.5, step=0.5, title="TSL Increment (%)", group="Trailing Stop Loss", tooltip="Profit increment steps for trailing stop (e.g., 1% means SL moves up every 1% profit)")
initialSLPercent = input.float(1.0, minval=0.5, step=0.5, title="Initial Stop Loss (%)", group="Trailing Stop Loss", tooltip="Initial stop loss distance from entry price")

// ==================== ICHIMOKU CALCULATIONS ====================
// Donchian calculation
donchian(len) => math.avg(ta.lowest(len), ta.highest(len))

// Ichimoku Lines
conversionLine = donchian(conversionPeriods)
baseLine = donchian(basePeriods)
leadLine1 = math.avg(conversionLine, baseLine)
leadLine2 = donchian(laggingSpan2Periods)

// Cloud conditions (using displaced values for current price position)
offsetLeadline1 = leadLine1[displacement - 1]
offsetLeadline2 = leadLine2[displacement - 1]

bool bullishCloud = leadLine1 > leadLine2
bool bearishCloud = leadLine1 < leadLine2
bool TKCrossUp = conversionLine > baseLine
bool TKCrossDown = conversionLine < baseLine
bool priceAboveSupport = close >= offsetLeadline1
bool priceBelowResistance = close <= offsetLeadline2

// ==================== ENTRY CONDITIONS ====================
// Long entry: TK Cross Up + Price Above Cloud Support + Bullish Cloud
longCondition = TKCrossUp and priceAboveSupport and bullishCloud
longSignal = longCondition and not longCondition[1]
longEntry = longSignal and strategy.position_size == 0

// Short entry: TK Cross Down + Price Below Cloud Resistance + Bearish Cloud
shortCondition = TKCrossDown and priceBelowResistance and bearishCloud
shortSignal = shortCondition and not shortCondition[1]
shortEntry = shortSignal and strategy.position_size == 0

// ==================== TRAILING STOP LOSS LOGIC ====================
var float entryPrice = na
var float currentStopLevel = na
var int positionDirection = 0  // 1 = long, -1 = short, 0 = flat

// Track entry price and reset variables on new position
if longEntry
    entryPrice := close
    currentStopLevel := useTSL ? close * (1 - initialSLPercent / 100) : na
    positionDirection := 1

if shortEntry
    entryPrice := close
    currentStopLevel := useTSL ? close * (1 + initialSLPercent / 100) : na
    positionDirection := -1

// Calculate current profit percentage (works for both long and short)
profitPercent = strategy.position_size > 0 ? (close - entryPrice) / entryPrice * 100 :
                strategy.position_size < 0 ? (entryPrice - close) / entryPrice * 100 : 0.0

// Update trailing stop based on arithmetic progression (1% increments)
if useTSL and strategy.position_size != 0
    // Calculate how many increment steps we've achieved
    stepsAchieved = math.floor(profitPercent / tslIncrement)

    // Stop loss progression:
    // Entry (0 steps)         -> SL at -initialSLPercent%
    // At 1% profit (1 step)   -> SL at 0% (breakeven)
    // At 2% profit (2 steps)  -> SL at 1%
    // At 3% profit (3 steps)  -> SL at 2%
    // etc.
    if stepsAchieved >= 1
        newStopPercent = (stepsAchieved - 1) * tslIncrement

        if positionDirection == 1  // Long position
            newStopPrice = entryPrice * (1 + newStopPercent / 100)
            if newStopPrice > currentStopLevel
                currentStopLevel := newStopPrice
        else if positionDirection == -1  // Short position
            newStopPrice = entryPrice * (1 - newStopPercent / 100)
            if newStopPrice < currentStopLevel
                currentStopLevel := newStopPrice

// Reset on position close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    positionDirection := 0

// ==================== EXIT CONDITIONS ====================
// Long exits
exitLongTKCross = strategy.position_size > 0 and TKCrossDown
longTrailingStopHit = useTSL and strategy.position_size > 0 and not na(currentStopLevel) and close < currentStopLevel

// Short exits
exitShortTKCross = strategy.position_size < 0 and TKCrossUp
shortTrailingStopHit = useTSL and strategy.position_size < 0 and not na(currentStopLevel) and close > currentStopLevel

// ==================== EXECUTE TRADES ====================
if longEntry
    strategy.entry("Long", strategy.long)

if shortEntry
    strategy.entry("Short", strategy.short)

if exitLongTKCross
    strategy.close("Long", comment="TK Cross Down")

if longTrailingStopHit
    strategy.close("Long", comment="Trailing SL")

if exitShortTKCross
    strategy.close("Short", comment="TK Cross Up")

if shortTrailingStopHit
    strategy.close("Short", comment="Trailing SL")

// ==================== PLOTTING ====================
// Plot Ichimoku Lines
plot(conversionLine, color=#2962FF, linewidth=2, title="Conversion Line (Tenkan)")
plot(baseLine, color=#B71C1C, linewidth=2, title="Base Line (Kijun)")

// Plot Ichimoku Cloud
p1 = plot(leadLine1, offset = displacement - 1, color=#A5D6A7, title="Leading Span A")
p2 = plot(leadLine2, offset = displacement - 1, color=#EF9A9A, title="Leading Span B")
fill(p1, p2, color = leadLine1 > leadLine2 ? color.rgb(67, 160, 71, 50) : color.rgb(244, 67, 54, 50))

// Plot trailing stop level when in position (only if TSL enabled)
stopPlot = useTSL and strategy.position_size != 0 and not na(currentStopLevel) ? currentStopLevel : na
plot(stopPlot, color=color.red, linewidth=2, style=plot.style_stepline, title="Trailing Stop")

// Plot entry price when in position
entryPlot = strategy.position_size != 0 ? entryPrice : na
plot(entryPlot, color=color.green, linewidth=1, style=plot.style_linebr, title="Entry Price")

// Plot entry signals
plotshape(longEntry, style=shape.labelup, location=location.belowbar, color=color.green, size=size.normal, text="LONG", textcolor=color.white, title="Long Entry Signal")
plotshape(shortEntry, style=shape.labeldown, location=location.abovebar, color=color.red, size=size.normal, text="SHORT", textcolor=color.white, title="Short Entry Signal")

// ==================== LABELS & INFO ====================
// Show profit percentage and stop level on chart
if barstate.islast and strategy.position_size != 0
    posType = strategy.position_size > 0 ? "LONG" : "SHORT"
    labelText = posType + " | Profit: " + str.tostring(profitPercent, "#.##") + "%\n"
    labelText += not useTSL ? "TSL: Disabled" : na(currentStopLevel) ? "TSL: Not Active" : "TSL: " + str.tostring(currentStopLevel, "#.##")
    labelLoc = strategy.position_size > 0 ? high : low
    labelStyle = strategy.position_size > 0 ? label.style_label_down : label.style_label_up
    label.new(bar_index, labelLoc, labelText, style=labelStyle, color=color.new(color.blue, 80), textcolor=color.white)

// ==================== ALERTS ====================
alertcondition(longEntry, title="Long Entry", message="Ichimoku Long Entry Signal")
alertcondition(shortEntry, title="Short Entry", message="Ichimoku Short Entry Signal")
alertcondition(exitLongTKCross or exitShortTKCross, title="TK Cross Exit", message="TK Cross Exit Signal")
alertcondition(longTrailingStopHit or shortTrailingStopHit, title="Trailing Stop Hit", message="Trailing Stop Loss triggered")
