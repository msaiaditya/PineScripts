//@version=5
strategy("Ichimoku Cloud with Trailing SL", shorttitle="Ichi TSL", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Description: Long/Short crypto strategy using Ichimoku Cloud for entries with arithmetic progression trailing stop loss
// Long Entry: TK Cross Up + Price Above Cloud Support + Bullish Cloud + Bull Regime
// Short Entry: TK Cross Down + Price Below Cloud Resistance + Bearish Cloud + Bear Regime
// Exit: Opposite TK Cross or Trailing stop loss (1% increment steps)
// Regime Filter: Higher timeframe Ichimoku cloud determines allowed trade direction

// ==================== INPUTS ====================
// Ichimoku Settings
conversionPeriods = input.int(20, minval=1, title="Conversion Line Length", group="Ichimoku")
basePeriods = input.int(60, minval=1, title="Base Line Length", group="Ichimoku")
laggingSpan2Periods = input.int(120, minval=1, title="Leading Span B Length", group="Ichimoku")
displacement = input.int(30, minval=1, title="Displacement", group="Ichimoku")

// Trade Direction Settings
enableLong = input.bool(true, title="Enable Long Trades", group="Trade Direction")
enableShort = input.bool(true, title="Enable Short Trades", group="Trade Direction")

// Leverage Settings
leverage = input.int(1, minval=1, maxval=125, title="Leverage", group="Position Sizing", tooltip="Leverage multiplier (1-125x). Position size = Equity × Leverage")

// Regime Filter Settings
regimeTimeframe = input.string("D", title="Regime Timeframe", options=["240", "D", "W"], group="Regime Filter", tooltip="4H, Daily, or Weekly")
regimeTenkanPeriod = input.int(10, minval=1, title="Regime Tenkan Period", group="Regime Filter")
regimeKijunPeriod = input.int(30, minval=1, title="Regime Kijun Period", group="Regime Filter")
regimeSenkouBPeriod = input.int(60, minval=1, title="Regime Senkou B Period", group="Regime Filter")
allowNeutralTrades = input.bool(false, title="Allow Trades in Neutral", group="Regime Filter", tooltip="When enabled, both long and short trades are allowed in neutral regime")
showRegimeBackground = input.bool(true, title="Show Regime Background", group="Regime Filter")

// Trailing Stop Loss Settings
useTSL = input.bool(true, title="Enable Trailing Stop Loss", group="Trailing Stop Loss")
tslIncrement = input.float(1.0, minval=0.5, step=0.5, title="TSL Increment (%)", group="Trailing Stop Loss", tooltip="Profit increment steps for trailing stop (e.g., 1% means SL moves up every 1% profit)")
initialSLPercent = input.float(1.0, minval=0.5, step=0.5, title="Initial Stop Loss (%)", group="Trailing Stop Loss", tooltip="Initial stop loss distance from entry price")

// ==================== REGIME CALCULATION ====================
// Calculate regime Ichimoku components on higher timeframe
regimeDonchian(len) => math.avg(ta.lowest(low, len), ta.highest(high, len))

// Calculate Span A and Span B for regime
regimeSpanA = math.avg(regimeDonchian(regimeTenkanPeriod), regimeDonchian(regimeKijunPeriod))
regimeSpanB = regimeDonchian(regimeSenkouBPeriod)

// Get higher timeframe values
htfSpanA = request.security(syminfo.tickerid, regimeTimeframe, regimeSpanA, lookahead=barmerge.lookahead_off)
htfSpanB = request.security(syminfo.tickerid, regimeTimeframe, regimeSpanB, lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, regimeTimeframe, close, lookahead=barmerge.lookahead_off)

// Determine regime state: 1 = Bull, -1 = Bear, 0 = Neutral
// Bull: Close > Span A AND Close > Span B (above cloud)
// Bear: Close < Span A AND Close < Span B (below cloud)
// Neutral: Close is between Span A and Span B (inside cloud)
cloudTop = math.max(htfSpanA, htfSpanB)
cloudBottom = math.min(htfSpanA, htfSpanB)

var int regime_state = 0
if not na(htfSpanA) and not na(htfSpanB)
    if htfClose > cloudTop
        regime_state := 1   // Bull
    else if htfClose < cloudBottom
        regime_state := -1  // Bear
    else
        regime_state := 0   // Neutral

// Expose regime filter variables for entry conditions
bool allow_long = (regime_state == 1) or (regime_state == 0 and allowNeutralTrades)
bool allow_short = (regime_state == -1) or (regime_state == 0 and allowNeutralTrades)

// Track regime changes for alerts and markers
regimeChangedToBull = regime_state == 1 and regime_state[1] != 1
regimeChangedToBear = regime_state == -1 and regime_state[1] != -1
regimeChangedToNeutral = regime_state == 0 and regime_state[1] != 0

// ==================== ICHIMOKU CALCULATIONS ====================
// Donchian calculation
donchian(len) => math.avg(ta.lowest(len), ta.highest(len))

// Ichimoku Lines
conversionLine = donchian(conversionPeriods)
baseLine = donchian(basePeriods)
leadLine1 = math.avg(conversionLine, baseLine)
leadLine2 = donchian(laggingSpan2Periods)

// Cloud conditions (using displaced values for current price position)
offsetLeadline1 = leadLine1[displacement - 1]
offsetLeadline2 = leadLine2[displacement - 1]

bool bullishCloud = leadLine1 > leadLine2
bool bearishCloud = leadLine1 < leadLine2
bool TKCrossUp = conversionLine > baseLine
bool TKCrossDown = conversionLine < baseLine
bool priceAboveSupport = close >= offsetLeadline1
bool priceBelowResistance = close <= offsetLeadline2

// ==================== ENTRY CONDITIONS ====================
// Long entry: TK Cross Up + Price Above Cloud Support + Bullish Cloud + Regime allows long
longCondition = TKCrossUp and priceAboveSupport and bullishCloud
longSignal = longCondition and not longCondition[1]
longEntry = enableLong and allow_long and longSignal and strategy.position_size == 0

// Short entry: TK Cross Down + Price Below Cloud Resistance + Bearish Cloud + Regime allows short
shortCondition = TKCrossDown and priceBelowResistance and bearishCloud
shortSignal = shortCondition and not shortCondition[1]
shortEntry = enableShort and allow_short and shortSignal and strategy.position_size == 0

// ==================== TRAILING STOP LOSS LOGIC ====================
var float entryPrice = na
var float currentStopLevel = na
var int positionDirection = 0  // 1 = long, -1 = short, 0 = flat

// Track entry price and reset variables on new position
if longEntry
    entryPrice := close
    currentStopLevel := useTSL ? close * (1 - initialSLPercent / 100) : na
    positionDirection := 1

if shortEntry
    entryPrice := close
    currentStopLevel := useTSL ? close * (1 + initialSLPercent / 100) : na
    positionDirection := -1

// Calculate current profit percentage (works for both long and short)
profitPercent = strategy.position_size > 0 ? (close - entryPrice) / entryPrice * 100 : strategy.position_size < 0 ? (entryPrice - close) / entryPrice * 100 : 0.0

// Update trailing stop based on arithmetic progression
if useTSL and strategy.position_size != 0
    // Calculate how many increment steps we've achieved
    stepsAchieved = math.floor(profitPercent / tslIncrement)

    // Stop loss progression (with 5% initial SL and 2% increment example):
    // Entry (0 steps)         -> SL at -5%
    // At 2% profit (1 step)   -> SL at -3%
    // At 4% profit (2 steps)  -> SL at -1%
    // At 6% profit (3 steps)  -> SL at +1%
    // At 8% profit (4 steps)  -> SL at +3%
    // Formula: SL% = -initialSL + (steps × increment)
    if stepsAchieved >= 1
        newStopPercent = -initialSLPercent + (stepsAchieved * tslIncrement)

        if positionDirection == 1  // Long position
            newStopPrice = entryPrice * (1 + newStopPercent / 100)
            if newStopPrice > currentStopLevel
                currentStopLevel := newStopPrice
        else if positionDirection == -1  // Short position
            newStopPrice = entryPrice * (1 - newStopPercent / 100)
            if newStopPrice < currentStopLevel
                currentStopLevel := newStopPrice

// Reset on position close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    positionDirection := 0

// ==================== EXIT CONDITIONS ====================
// Long exits
exitLongTKCross = strategy.position_size > 0 and TKCrossDown
longTrailingStopHit = useTSL and strategy.position_size > 0 and not na(currentStopLevel) and close < currentStopLevel

// Short exits
exitShortTKCross = strategy.position_size < 0 and TKCrossUp
shortTrailingStopHit = useTSL and strategy.position_size < 0 and not na(currentStopLevel) and close > currentStopLevel

// ==================== EXECUTE TRADES ====================
// Calculate leveraged position size (in units of the asset)
leveragedQty = (strategy.equity * leverage) / close

if longEntry
    strategy.entry("Long", strategy.long, qty=leveragedQty)

if shortEntry
    strategy.entry("Short", strategy.short, qty=leveragedQty)

if exitLongTKCross
    strategy.close("Long", comment="TK Cross Down")

if longTrailingStopHit
    strategy.close("Long", comment="Trailing SL")

if exitShortTKCross
    strategy.close("Short", comment="TK Cross Up")

if shortTrailingStopHit
    strategy.close("Short", comment="Trailing SL")

// ==================== PLOTTING ====================
// Regime background
regimeColor = regime_state == 1 ? color.new(color.green, 90) : regime_state == -1 ? color.new(color.red, 90) : color.new(color.gray, 95)
bgcolor(showRegimeBackground ? regimeColor : na, title="Regime Background")

// Regime change markers
plotshape(regimeChangedToBull, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Regime Bull Marker")
plotshape(regimeChangedToBear, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Regime Bear Marker")

// Plot Ichimoku Lines
plot(conversionLine, color=#2962FF, linewidth=2, title="Conversion Line (Tenkan)")
plot(baseLine, color=#B71C1C, linewidth=2, title="Base Line (Kijun)")

// Plot Ichimoku Cloud
p1 = plot(leadLine1, offset = displacement - 1, color=#A5D6A7, title="Leading Span A")
p2 = plot(leadLine2, offset = displacement - 1, color=#EF9A9A, title="Leading Span B")
fill(p1, p2, color = leadLine1 > leadLine2 ? color.rgb(67, 160, 71, 50) : color.rgb(244, 67, 54, 50))

// Plot trailing stop level when in position (only if TSL enabled)
stopPlot = useTSL and strategy.position_size != 0 and not na(currentStopLevel) ? currentStopLevel : na
plot(stopPlot, color=color.red, linewidth=2, style=plot.style_stepline, title="Trailing Stop")

// Plot entry price when in position
entryPlot = strategy.position_size != 0 ? entryPrice : na
plot(entryPlot, color=color.green, linewidth=1, style=plot.style_linebr, title="Entry Price")

// Plot entry signals
plotshape(longEntry, style=shape.labelup, location=location.belowbar, color=color.green, size=size.normal, text="LONG", textcolor=color.white, title="Long Entry Signal")
plotshape(shortEntry, style=shape.labeldown, location=location.abovebar, color=color.red, size=size.normal, text="SHORT", textcolor=color.white, title="Short Entry Signal")

// ==================== LABELS & INFO ====================
// Show profit percentage and stop level on chart
if barstate.islast and strategy.position_size != 0
    posType = strategy.position_size > 0 ? "LONG" : "SHORT"
    regimeText = regime_state == 1 ? "BULL" : regime_state == -1 ? "BEAR" : "NEUTRAL"
    labelText = posType + " | Regime: " + regimeText + "\n"
    labelText += "Profit: " + str.tostring(profitPercent, "#.##") + "%\n"
    labelText += not useTSL ? "TSL: Disabled" : na(currentStopLevel) ? "TSL: Not Active" : "TSL: " + str.tostring(currentStopLevel, "#.##")
    labelLoc = strategy.position_size > 0 ? high : low
    labelStyle = strategy.position_size > 0 ? label.style_label_down : label.style_label_up
    label.new(bar_index, labelLoc, labelText, style=labelStyle, color=color.new(color.blue, 80), textcolor=color.white)

// ==================== ALERTS ====================
alertcondition(longEntry, title="Long Entry", message="Ichimoku Long Entry Signal")
alertcondition(shortEntry, title="Short Entry", message="Ichimoku Short Entry Signal")
alertcondition(exitLongTKCross or exitShortTKCross, title="TK Cross Exit", message="TK Cross Exit Signal")
alertcondition(longTrailingStopHit or shortTrailingStopHit, title="Trailing Stop Hit", message="Trailing Stop Loss triggered")
alertcondition(regimeChangedToBull, title="Regime: Bull", message="Regime changed to Bull - Longs allowed")
alertcondition(regimeChangedToBear, title="Regime: Bear", message="Regime changed to Bear - Shorts allowed")
alertcondition(regimeChangedToNeutral, title="Regime: Neutral", message="Regime changed to Neutral - Inside cloud")
